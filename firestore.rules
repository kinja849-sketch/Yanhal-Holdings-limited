rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'photoURL', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
             data.photoURL is string && data.photoURL.size() >= 10 && data.photoURL.size() <= 1000 &&
             data.createdAt is string; // Using string as frontend sends ISO string
    }

    // --- Collection Routes ---

    match /users/{userId} {
      // Identity Poisoning Guard
      allow get: if isOwner(userId) && isValidId(userId);
      
      // Query Enforcer
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(incoming()) && 
                      incoming().uid == request.auth.uid;

      allow update: if isOwner(userId) && 
                      isValidId(userId) && 
                      isValidUser(incoming()) &&
                      // Action: Update Profile
                      (incoming().diff(existing()).affectedKeys().hasOnly(['photoURL', 'displayName']) || 
                       incoming().diff(existing()).affectedKeys().hasOnly(['photoURL'])) &&
                      incoming().uid == existing().uid &&
                      incoming().email == existing().email &&
                      incoming().createdAt == existing().createdAt;
    }

    match /submissions/{submissionId} {
      // Currently submissions are handled via backend API. 
      // If we were to allow client-side writes, we would add rules here.
      allow read, write: if false;
    }
  }
}
